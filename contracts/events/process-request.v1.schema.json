{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ProcessRequest v1",
  "description": "Contrato para solicitar al futuro worker Python el procesamiento de un original ya verificado.",
  "type": "object",
  "required": ["schema_version", "tenant_id", "job_id", "resource_id", "request_id", "pipeline", "original"],
  "properties": {
    "schema_version": {"const": 1},
    "tenant_id": {"type": "string", "minLength": 1},
    "job_id": {"type": "string", "format": "uuid"},
    "resource_id": {"type": "string", "format": "uuid"},
    "request_id": {"type": "string"},
    "pipeline": {"enum": ["document", "image", "audio", "video"]},
    "original": {
      "type": "object",
      "required": ["container", "path", "content_type", "content_sha256"],
      "properties": {
        "container": {"type": "string", "minLength": 1},
        "path": {"type": "string", "minLength": 1},
        "content_type": {"type": "string", "minLength": 1},
        "content_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      }
    }
  }
}
